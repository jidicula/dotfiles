#!/usr/bin/env python3
"""Retry GitHub connection setup, never an unconfirmed remote operation."""

import argparse
import fcntl
import math
import os
from pathlib import Path
import re
import selectors
import shlex
import signal
import subprocess
import sys
import tempfile
import time


RPC_STARTUP_ERROR = re.compile(
    rb"error getting ssh server details: failed to invoke SSH RPC: "
    rb"rpc error: code = (?:DeadlineExceeded|Unavailable) desc = [^\r\n]+"
)
API_CONNECTION_ERROR = re.compile(
    rb"error connecting to api\.github\.com"
    rb"(?:\r?\ncheck your internet connection or https://githubstatus\.com)?"
)
CODESPACE_REFRESH_ERROR = re.compile(
    rb"getting full codespace details: error making request: Get "
    rb'"https://api\.github\.com/user/codespaces/[A-Za-z0-9._-]+'
    rb'\?internal=true&refresh=true": '
    rb"(?:net/http: TLS handshake timeout|unexpected EOF)"
)
API_GET_ERROR = re.compile(
    rb'Get "https://api\.github\.com/[^\r\n"]+": '
    rb"(?:net/http: TLS handshake timeout|unexpected EOF)"
)
AUTHENTICATED = re.compile(rb'Authenticated to [^\r\n]+ using "publickey"\.')
SIGNING_REFUSAL = re.compile(
    rb"sign_and_send_pubkey:[^\r\n]*"
    rb"(?:agent refused operation|communication with agent failed)(?:\r?\n|\Z)"
)
AUTHENTICATION_DENIAL = re.compile(
    rb"(?:[^@\s]+@[^@\s]+: )?Permission denied "
    rb"\([a-z0-9@._+-]+(?:,[a-z0-9@._+-]+)*\)\.?"
)
AUTHENTICATION_LIMIT = 3
SETUP_PROGRESS_INTERVAL = 10
RESUME_AUTHENTICATION = (
    "request operator approval, then run copilot-ghcs resume-auth --operator-approved"
)


def log(message):
    print(f"[copilot-gh-retry] {message}", file=sys.stderr, flush=True)


def startup_failure(stderr, had_stdout, *, api_get=False):
    # gh emits these errors before invoking ssh/scp. A remote failure instead
    # ends with "shell closed:" or "tunnel closed:". Require the ENTIRE error,
    # not an embedded line or merely the absence of a runner acknowledgement.
    error = stderr.strip()
    return not had_stdout and bool(
        RPC_STARTUP_ERROR.fullmatch(error)
        or API_CONNECTION_ERROR.fullmatch(error)
        or CODESPACE_REFRESH_ERROR.fullmatch(error)
        or (api_get and API_GET_ERROR.fullmatch(error))
    )


class AuthenticationPaused(Exception):
    pass


class ConnectionGate:
    """Serialize signing and enforce a shared authentication-failure limit."""

    def __init__(self, path, deadline=None, *, allow_paused=False):
        self.path = path
        self.deadline = deadline
        self.allow_paused = allow_paused
        self.fd = None

    def __enter__(self):
        if self.path is None:
            return self
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        deadline = self.deadline if self.deadline is not None else time.monotonic() + 120
        waiting = False
        try:
            while True:
                try:
                    fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    if not self.allow_paused and self.refusals() >= AUTHENTICATION_LIMIT:
                        raise AuthenticationPaused(
                            "SSH authentication is paused after three consecutive "
                            f"failures; {RESUME_AUTHENTICATION}"
                        )
                    return self
                except BlockingIOError:
                    if not waiting:
                        log("waiting for another Secretive connection to finish signing")
                        waiting = True
                    if time.monotonic() >= deadline:
                        raise TimeoutError("connection gate remained busy until the setup deadline")
                    time.sleep(0.1)
        except BaseException:
            self.release()
            raise

    def refusals(self):
        value = os.pread(self.fd, 2, 0)
        if value == b"":
            return 0
        if value not in (b"0", b"1", b"2", b"3"):
            raise AuthenticationPaused(
                f"invalid authentication state in connection gate; {RESUME_AUTHENTICATION}"
            )
        return int(value)

    def store_refusals(self, count):
        # Keep the locked inode: replacing it would let queued signers bypass the gate.
        if os.pwrite(self.fd, str(count).encode("ascii"), 0) != 1:
            raise OSError("could not persist the SSH authentication-failure count")
        os.ftruncate(self.fd, 1)
        os.fsync(self.fd)

    def authenticated(self):
        if self.fd is not None:
            if self.refusals():
                self.store_refusals(0)
            self.release()

    def refused(self):
        if self.fd is not None:
            count = self.refusals() + 1
            self.store_refusals(count)
            log(f"SSH authentication failure {count}/{AUTHENTICATION_LIMIT}; no automatic retry")
            if count == AUTHENTICATION_LIMIT:
                log(f"further authentication is paused; {RESUME_AUTHENTICATION}")

    def release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __exit__(self, *_):
        self.release()


def stop_process(process):
    previous = signal.signal(signal.SIGTERM, signal.SIG_IGN)
    try:
        # gh can exit while an SSH child still holds its output pipes open.
        os.killpg(os.getpid(), signal.SIGTERM)
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            log("connection process did not stop; killing its local process group")
            os.killpg(os.getpid(), signal.SIGKILL)
    finally:
        signal.signal(signal.SIGTERM, previous)


def prepare_identity(public_key, standin):
    public_key = str(Path(public_key).resolve(strict=True))
    if not Path(public_key).is_file():
        raise OSError("Secretive public-key stand-in is not a file")
    paths = (Path(standin), Path(str(standin) + ".pub"))
    for path in paths:
        if path.exists() and not path.is_symlink():
            raise FileExistsError(f"refusing to replace non-symlink path: {path}")
    changed = [
        path for path in paths
        if not path.is_symlink() or os.readlink(path) != public_key
    ]
    if changed:
        with tempfile.TemporaryDirectory(
            prefix=".copilot-ghcs-identity-", dir=paths[0].parent,
        ) as directory:
            for index, path in enumerate(changed):
                link = Path(directory) / str(index)
                link.symlink_to(public_key)
                os.replace(link, path)


def read_public_key(public_key):
    lines = Path(public_key).read_text(encoding="utf-8").strip().splitlines()
    fields = lines[0].split() if len(lines) == 1 else []
    if (len(fields) < 2
            or not re.fullmatch(r"(?:ssh-|ecdsa-|sk-)[A-Za-z0-9@._+-]+", fields[0])
            or not re.fullmatch(r"[A-Za-z0-9+/]+={0,2}", fields[1])):
        raise ValueError("Secretive requires a single OpenSSH public-key line")
    return " ".join(fields[:2])


def signing_command(command, public_key):
    key = shlex.quote(read_public_key(public_key))
    prefix = (f"export COPILOT_CS_SIGNING_KEY={key} "
              'COPILOT_CS_SIGNING_SOCKET="$SSH_AUTH_SOCK"; ')
    return [*command[:-1], prefix + command[-1]]


def run_once(command, gate, deadline, ack_marker=None, api_get=False):
    started = time.monotonic()
    next_progress = started + SETUP_PROGRESS_INTERVAL
    reported_progress = False
    authenticated = False
    authentication_failed = False
    process = subprocess.Popen(
        command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        bufsize=0,
    )
    stderr = bytearray()
    stderr_overflow = False
    had_stdout = False
    stderr_tail = b""
    stdout_tail = b"\n"
    marker = ack_marker.encode("ascii") if ack_marker else None
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ, sys.stdout.buffer)
            selector.register(process.stderr, selectors.EVENT_READ, sys.stderr.buffer)
            while selector.get_map() or process.poll() is None:
                wait = None if selector.get_map() else 0.1
                if deadline is not None:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError(
                            "connection setup deadline exceeded; remote outcome is unconfirmed; "
                            "inspect the job log or transferred files before retrying"
                        )
                    wait = min(0.2, remaining)
                    if not api_get and time.monotonic() >= next_progress:
                        phase = ("the exact runner acknowledgement"
                                 if authenticated and marker is not None
                                 else "API/SSH connection setup")
                        log(f"connection setup pending after {time.monotonic() - started:.1f}s; "
                            f"waiting for {phase}")
                        reported_progress = True
                        next_progress = time.monotonic() + SETUP_PROGRESS_INTERVAL
                for key, _ in selector.select(wait):
                    data = os.read(key.fd, 65536)
                    if not data:
                        selector.unregister(key.fileobj)
                        if key.fileobj is not process.stderr:
                            continue
                    if key.fileobj is process.stdout:
                        had_stdout = True
                        authenticated = True
                        gate.authenticated()
                        if marker is not None:
                            probe = stdout_tail + data
                            if (b"\n" + marker + b"\n" in probe
                                    or b"\n" + marker + b"\r\n" in probe):
                                if deadline is not None and reported_progress:
                                    log(f"runner acknowledged after {time.monotonic() - started:.1f}s")
                                deadline = None
                            stdout_tail = probe[-(len(marker) + 3):]
                        elif not api_get:
                            deadline = None
                    elif len(stderr) + len(data) <= 65536:
                        stderr.extend(data)
                    else:
                        stderr_overflow = True
                    if key.fileobj is process.stderr:
                        lines = (stderr_tail + data).split(b"\n")
                        stderr_tail = lines.pop()[-4096:] if data else b""
                        lines = [line.rstrip(b"\r") for line in lines]
                        authentication_failed = authentication_failed or any(
                            SIGNING_REFUSAL.search(line)
                            or AUTHENTICATION_DENIAL.fullmatch(line)
                            for line in lines
                        )
                        if any(AUTHENTICATED.fullmatch(line) for line in lines):
                            authenticated = True
                            if deadline is not None and reported_progress:
                                log(f"SSH authenticated after {time.monotonic() - started:.1f}s")
                            gate.authenticated()
                            if marker is None and not api_get:
                                deadline = None
                    key.data.write(data)
                    key.data.flush()
        status = process.wait()
        if status != 0 and not authenticated and authentication_failed:
            gate.refused()
        return status, b"" if stderr_overflow else bytes(stderr), had_stdout
    finally:
        stop_process(process)
        process.stdout.close()
        process.stderr.close()


def run(command, lock=None, retry=True, identity=None, ssh_signing=False, *,
        api_get=False, startup_timeout=120, ack_marker=None,
        signing_public_key=None):
    deadline = time.monotonic() + startup_timeout
    with ConnectionGate(lock, deadline) as gate:
        if identity is not None:
            if signing_public_key is not None:
                signing_key = read_public_key(signing_public_key)
                if read_public_key(identity[0]) == signing_key:
                    raise ValueError("transport and endorsement must use different Secretive keys")
                for alias in (Path(identity[1]), Path(str(identity[1]) + ".pub")):
                    if alias.resolve() == Path(signing_public_key).resolve():
                        raise ValueError("transport alias overlaps the protected signing identity")
            prepare_identity(*identity)
        if ssh_signing:
            command = signing_command(command, signing_public_key)
        for attempt in range(1, 4):
            if time.monotonic() >= deadline:
                raise TimeoutError("connection setup deadline exceeded before dispatch")
            status, stderr, had_stdout = run_once(
                command, gate, deadline, ack_marker, api_get,
            )
            if status == 0:
                gate.authenticated()
            if status == 0 or not retry or not startup_failure(
                stderr, had_stdout, api_get=api_get,
            ):
                return status if status >= 0 else 128 - status
            if attempt == 3:
                return status
            if time.monotonic() + attempt * 5 >= deadline:
                raise TimeoutError("connection setup deadline leaves no time for another retry")
            log(f"connection setup failed before dispatch; retrying ({attempt + 1}/3)")
            subprocess.run(["sleep", str(attempt * 5)], check=True)


class Interrupted(Exception):
    def __init__(self, number):
        self.number = number


def interrupt(number, _frame):
    raise Interrupted(number)


def positive_seconds(value):
    number = float(value)
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError("timeout must be finite and greater than zero")
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="mode", required=True)
    get = commands.add_parser("get", help="bounded read-only gh api GET")
    get.add_argument("endpoint")
    get.add_argument("--jq")
    connect = commands.add_parser("connect", help="internal Codespace transport")
    connect.add_argument("--lock", required=True)
    connect.add_argument("--no-retry", action="store_true")
    connect.add_argument("--public-key")
    connect.add_argument("--standin")
    connect.add_argument("--signing-public-key")
    connect.add_argument("--ssh-signing", action="store_true")
    connect.add_argument("--ack-marker")
    connect.add_argument("command", nargs=argparse.REMAINDER)
    resume = commands.add_parser("resume-auth", help="resume after explicit operator approval")
    resume.add_argument("--lock", required=True)
    resume.add_argument("--operator-approved", action="store_true", required=True)
    for subparser in (get, connect, resume):
        subparser.add_argument("--startup-timeout", type=positive_seconds, default=120)
    args = parser.parse_args()
    if args.mode == "get":
        command = ["gh", "api", "--method", "GET", args.endpoint]
        if args.jq is not None:
            command.extend(["--jq", args.jq])
        lock, retry, identity, ssh_signing = None, True, None, False
        ack_marker = None
        signing_public_key = None
    elif args.mode == "connect":
        command = args.command
        if command[:1] == ["--"]:
            command = command[1:]
        if command[:3] not in (["gh", "codespace", "ssh"], ["gh", "codespace", "cp"]):
            parser.error("connect accepts only gh codespace ssh or cp")
        if bool(args.public_key) != bool(args.standin):
            parser.error("--public-key and --standin must be supplied together; automatic key selection is disabled")
        lock, retry = args.lock, not args.no_retry
        identity = (args.public_key, args.standin) if args.standin else None
        signing_public_key = args.signing_public_key
        ssh_signing = args.ssh_signing
        if ssh_signing and (identity is None or signing_public_key is None
                            or command[:3] != ["gh", "codespace", "ssh"]):
            parser.error("SSH signing requires separate pinned identities and an SSH command")
        ack_marker = args.ack_marker
        if ack_marker is not None and (
            command[:3] != ["gh", "codespace", "ssh"]
            or not re.fullmatch(r"__COPILOT_CS_ACK_[A-Za-z0-9._-]+__", ack_marker)
        ):
            parser.error("--ack-marker requires an SSH runner acknowledgement")
    # Keep gh and its ssh child in our group so Emacs can stop the entire
    # local stream even with SIGKILL. Only the remote job detaches.
    if os.getpgrp() != os.getpid():
        os.setpgid(0, 0)
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, interrupt)
    try:
        if args.mode == "resume-auth":
            deadline = time.monotonic() + args.startup_timeout
            with ConnectionGate(args.lock, deadline, allow_paused=True) as gate:
                gate.store_refusals(0)
            log("authentication resumed after operator approval; previous commands were not replayed")
            return 0
        return run(
            command, lock, retry, identity, ssh_signing, api_get=args.mode == "get",
            startup_timeout=args.startup_timeout, ack_marker=ack_marker,
            signing_public_key=signing_public_key,
        )
    except Interrupted as error:
        log("interrupted; the remote outcome must be checked before rerunning")
        return 128 + error.number
    except AuthenticationPaused as error:
        log(str(error))
        return 75
    except TimeoutError as error:
        log(str(error))
        return 124
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        log(str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main())
