#!/usr/bin/env python3
"""Plan, sign, publish, and finalise a revision-specific Codespace endorsement."""

import argparse
import base64
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import quote


SIGNING_ALIAS = "~/.ssh/secretive-stormbreaker-github-sep-2026.pub"
RESULT_PREFIX = "COPILOT_ENDORSEMENT_RESULT "
OID = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})\Z")
PLAN_ID = re.compile(r"[0-9a-f]{64}\Z")


def require(condition, message):
    if not condition:
        raise ValueError(message)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def digest(value):
    return hashlib.sha256(canonical(value).encode()).hexdigest()


def public_key(value):
    require(isinstance(value, str), "expected an OpenSSH public-key string")
    lines = value.strip().splitlines()
    fields = lines[0].split() if len(lines) == 1 else []
    require(len(fields) >= 2 and re.fullmatch(r"(?:ssh-|ecdsa-|sk-)[\w@.+-]+", fields[0]),
            "expected one OpenSSH public key")
    blob = base64.b64decode(fields[1], validate=True)
    require(len(blob) > 4, "invalid SSH public key")
    length = int.from_bytes(blob[:4], "big")
    require(blob[4:4 + length] == fields[0].encode(), "SSH public-key algorithm mismatch")
    return " ".join(fields[:2])


def fingerprint(key):
    blob = base64.b64decode(public_key(key).split()[1], validate=True)
    return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")


def run(arguments, *, data=None, env=None, timeout=120, echo=False):
    output = None if echo else subprocess.PIPE
    result = subprocess.run(arguments, input=data, stdout=output,
                            stderr=output, env=env, timeout=timeout)
    if result.returncode:
        detail = ("see command output above" if echo else
                  result.stderr.decode("utf-8", errors="replace").strip())
        raise RuntimeError(
            f"{arguments[0]} failed ({result.returncode}): {detail}"
        )
    return result.stdout or b""


def github(endpoint, method="GET", data=None):
    arguments = ["gh", "api", "--hostname", "github.com", "--method", method, endpoint]
    if data is not None:
        arguments += ["--input", "-"]
    return json.loads(run(arguments, data=canonical(data).encode() if data is not None else None))


def github_pages(endpoint, *, field=None):
    pages = json.loads(run([
        "gh", "api", "--hostname", "github.com", "--paginate", "--slurp", endpoint,
    ]))
    require(isinstance(pages, list) and pages, "invalid paginated GitHub response")
    if field is not None:
        require(all(isinstance(page, dict) and isinstance(page.get(field), list)
                    and type(page.get("total_count")) is int for page in pages),
                "invalid paginated GitHub response")
        require(all(page["total_count"] == pages[0]["total_count"] for page in pages)
                and sum(len(page[field]) for page in pages) == pages[0]["total_count"],
                "incomplete or changing paginated GitHub response")
        pages = [page[field] for page in pages]
    require(all(isinstance(page, list) for page in pages), "invalid paginated GitHub response")
    return [item for page in pages for item in page]


def authenticated_operator():
    operator = github("user")
    require(isinstance(operator, dict) and isinstance(operator.get("login"), str)
            and re.fullmatch(r"[A-Za-z0-9-]+", operator["login"]),
            "cannot identify the authenticated operator")
    return operator["login"]


def validate_request(request):
    require(isinstance(request, dict), "expected an endorsement request object")
    require(request.get("version") == 1, "unsupported endorsement request version")
    require(isinstance(request.get("repository"), str)
            and re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", request["repository"]),
            "invalid repository")
    require(type(request.get("pr")) is int and request["pr"] > 0, "invalid pull request")
    require(request.get("url") == f"https://github.com/{request['repository']}/pull/{request['pr']}",
            "pull-request URL does not match the repository")
    for field in ("head", "base"):
        require(isinstance(request.get(field), str) and OID.fullmatch(request[field]),
                f"invalid {field} object id")
    for field in ("source_branch", "base_branch", "target_branch"):
        require(isinstance(request.get(field), str), f"missing {field}")
        run(["git", "check-ref-format", "refs/heads/" + request[field]])
    require(request["source_branch"] != request["base_branch"], "cannot endorse the base branch")
    require(request["target_branch"] == request["source_branch"] + "-signed",
            "signed branch must append -signed to the source branch")
    require(request.get("publication_options") in (["replacement"], ["replacement", "replace"]),
            "invalid publication options")
    if "attestor" in request:
        require(isinstance(request["attestor"], str)
                and re.fullmatch(r"[A-Za-z0-9-]+", request["attestor"]), "invalid attestor login")
    if "committer" in request:
        committer = request["committer"]
        require(isinstance(committer, dict) and set(committer) == {"name", "email"},
                "committer requires only an explicit name and email")
        require(isinstance(committer["name"], str) and committer["name"].strip()
                and committer["name"] == committer["name"].strip()
                and not re.search(r"[\x00-\x1f\x7f<>]", committer["name"]),
                "invalid committer name")
        require(isinstance(committer["email"], str)
                and re.fullmatch(r"[^\s\x00-\x1f\x7f<>@]+@[^\s\x00-\x1f\x7f<>@]+",
                                 committer["email"]), "invalid committer email")
    require(request.get("key") == public_key(request.get("key", "")), "noncanonical signing key")
    require(request.get("fingerprint") == fingerprint(request["key"]), "signing fingerprint mismatch")


def pull_request(repository, number, *, require_draft=True):
    pr = github(f"repos/{repository}/pulls/{number}")
    require(pr["head"]["repo"] is not None
            and pr["head"]["repo"]["full_name"] == repository
            and pr["base"]["repo"]["full_name"] == repository,
            "endorsement currently requires a same-repository pull request")
    require(not pr["merged"], "endorsement requires an unmerged pull request")
    require(not require_draft or pr["draft"], "endorsement requires a draft pull request")
    return pr


def branch_head(repository, branch):
    """Read the live tip; a PR's base.sha may be a historical snapshot."""
    ref = github(f"repos/{repository}/git/ref/heads/{quote(branch, safe='')}")
    require(isinstance(ref, dict) and ref.get("ref") == "refs/heads/" + branch
            and isinstance(ref.get("object"), dict), "invalid live branch reference")
    commit = ref["object"]
    require(commit.get("type") == "commit" and isinstance(commit.get("sha"), str)
            and OID.fullmatch(commit["sha"]), "invalid live branch commit")
    return commit["sha"]


def require_base_compatibility(request, base, mergeable):
    """Keep the reviewed range fixed while accepting a conflict-free base advance."""
    require(isinstance(base, str) and OID.fullmatch(base), "invalid current base commit")
    if base == request["base"]:
        return
    comparison = github(
        f"repos/{request['repository']}/compare/{request['base']}...{base}?per_page=1")
    require(isinstance(comparison, dict)
            and comparison.get("status") in ("ahead", "behind", "diverged", "identical")
            and isinstance(comparison.get("base_commit"), dict)
            and comparison["base_commit"].get("sha") == request["base"]
            and isinstance(comparison.get("merge_base_commit"), dict)
            and isinstance(comparison["merge_base_commit"].get("sha"), str)
            and OID.fullmatch(comparison["merge_base_commit"]["sha"]),
            "base ancestry is unconfirmed; retry the same plan when it is available")
    require(comparison["status"] == "ahead"
            and comparison["merge_base_commit"]["sha"] == request["base"],
            "base branch changed without a confirmed fast-forward; obtain a new endorsement")
    require(mergeable != "CONFLICTING",
            "base branch changed with merge conflicts; resolve them before endorsement")
    require(mergeable == "MERGEABLE",
            "current base mergeability is unconfirmed; retry the same plan when it is available")


def confirm_base_compatibility(request, pr):
    """Check GitHub's mergeability for the exact head and current base, without mutation."""
    query = """
        query EndorsementBaseCompatibility($id: ID!) {
          node(id: $id) {
            ... on PullRequest {
              id state headRefOid headRefName baseRefName mergeable
              baseRef { target { oid } }
            }
          }
        }
    """
    for _ in range(3):
        if branch_head(request["repository"], request["base_branch"]) == request["base"]:
            return
        response = github("graphql", "POST", {
            "query": query, "variables": {"id": pr["node_id"]},
        })
        require(isinstance(response, dict) and not response.get("errors")
                and isinstance(response.get("data"), dict),
                "GitHub could not confirm base mergeability; retain the same plan")
        current = response["data"].get("node")
        require(isinstance(current, dict) and current.get("id") == pr["node_id"]
                and current.get("state") == "OPEN"
                and current.get("headRefOid") == pr["head"]["sha"]
                and current.get("headRefName") == pr["head"]["ref"]
                and current.get("baseRefName") == request["base_branch"]
                and isinstance(current.get("baseRef"), dict)
                and isinstance(current["baseRef"].get("target"), dict),
                "PR changed or base mergeability is unavailable; quality gate not confirmed")
        base = current["baseRef"]["target"].get("oid")
        require_base_compatibility(request, base, current.get("mergeable"))
        if branch_head(request["repository"], request["base_branch"]) == base:
            require(branch_head(request["repository"], pr["head"]["ref"]) == pr["head"]["sha"],
                    "PR head branch changed; quality gate not confirmed")
            return
    raise ValueError("base kept advancing during mergeability checks; retry the same plan")


def replacement_allowed(repository, branch):
    """Return false on prohibited or uncertain history replacement."""
    path = quote(branch, safe="")
    try:
        rules = github(f"repos/{repository}/rules/branches/{path}")
        require(isinstance(rules, list), "invalid branch-rule response")
        if any(rule.get("type") == "non_fast_forward" for rule in rules):
            return False
        branch_info = github(f"repos/{repository}/branches/{path}")
        # Rulesets can mark a branch protected without enabling classic protection.
        summary = branch_info.get("protection")
        classic_disabled = isinstance(summary, dict) and summary.get("enabled") is False
        if not branch_info["protected"] or classic_disabled:
            return True
        protection = github(f"repos/{repository}/branches/{path}/protection")
        return protection.get("allow_force_pushes", {}).get("enabled") is True
    except (RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f"[copilot-cs-endorse] rewrite permission is uncertain; "
              f"only the replacement-draft option is available: {error}",
              file=sys.stderr)
        return False


def check_ci(repository, number):
    """Check an unsigned draft without starting endorsement preparation."""
    pr = pull_request(repository, number)
    require(pr["state"] == "open", "the original draft PR is not open")
    source = pr["head"]["ref"]
    base_branch = pr["base"]["ref"]
    request = {
        "repository": repository, "pr": number, "url": pr["html_url"],
        "source_branch": source,
        "base_branch": base_branch, "head": pr["head"]["sha"],
        "base": branch_head(repository, base_branch),
    }
    require_passing_checks(request, number, request["head"], source, require_draft=True)
    return request


def prepare(repository, number, key_path, *, committer=None):
    request = check_ci(repository, number)
    source = request["source_branch"]
    key = public_key(Path(key_path).expanduser().read_text())
    request.update(
        version=1, target_branch=source + "-signed",
        publication_options=["replacement"] + (
            ["replace"] if replacement_allowed(repository, source) else []),
        key=key, fingerprint=fingerprint(key), attestor=authenticated_operator(),
    )
    if committer is not None:
        request["committer"] = committer
    validate_request(request)
    if committer is not None:
        keys = github_pages("users/" + quote(request["attestor"], safe="")
                            + "/ssh_signing_keys?per_page=100")
        require(any(public_key(item["key"]) == key for item in keys),
                "the operator has not registered this SSH signing key")
    return request


class Repository:
    def __init__(self):
        self.env = dict(os.environ, GIT_NO_REPLACE_OBJECTS="1", GIT_OPTIONAL_LOCKS="0",
                        GIT_TERMINAL_PROMPT="0")
        self.root = self.git("rev-parse", "--show-toplevel").decode().strip()
        require(self.git("rev-parse", "--is-shallow-repository").strip() == b"false",
                "endorsement requires complete history, not a shallow checkout")
        common = Path(self.git("rev-parse", "--git-common-dir").decode().strip()).resolve()
        require(not (common / "info" / "grafts").exists(), "Git grafts are not supported")
        require(not self.git("for-each-ref", "--format=%(refname)", "refs/replace").strip(),
                "Git replacement objects are not supported")
        self.state = common / "copilot-endorsements"
        self.state.mkdir(mode=0o700, exist_ok=True)

    def git(self, *arguments, data=None):
        streaming = arguments[0] in ("fetch", "push")
        return run(["git", *arguments], data=data, env=self.env, echo=streaming,
                   timeout=None if streaming else 120)

    def ref(self, name):
        return self.git("rev-parse", "--verify", name).decode().strip()

    def validate_origin(self, request):
        expected = request["repository"].lower()
        for options in (("--all",), ("--push", "--all")):
            urls = self.git("remote", "get-url", *options, "origin").decode().splitlines()
            require(len(urls) == 1, "origin must have exactly one fetch and one push URL")
            match = re.fullmatch(
                r"(?:https://github\.com/|git@github\.com:)(.+?)(?:\.git)?/?", urls[0])
            require(match and match[1].lower() == expected,
                    "origin fetch/push URL does not match the reviewed GitHub repository")
        settings = self.git("config", "--get-regexp", r"^remote\.origin\.")
        if any(line.startswith(b"remote.origin.mirror ") for line in settings.splitlines()):
            require(self.git("config", "--bool", "--get", "remote.origin.mirror").strip() == b"false",
                    "a mirror remote cannot publish an endorsement")

    def remote_refs(self, request):
        self.validate_origin(request)
        output = self.git("ls-remote", "--heads", "origin",
                          *("refs/heads/" + request[field] for field in
                            ("source_branch", "base_branch", "target_branch")))
        return {line.split()[1]: line.split()[0] for line in output.decode().splitlines()}

    def ensure_commit(self, oid):
        object_type = self.git("cat-file", "--batch-check=%(objecttype)",
                               data=(oid + "\n").encode()).strip()
        if object_type == (oid + " missing").encode():
            print(f"[copilot-cs-endorse] fetching base history: {oid}",
                  file=sys.stderr, flush=True)
            self.git("fetch", "--progress", "--no-tags", "--no-write-fetch-head",
                     "--no-recurse-submodules", "--refmap=", "origin", oid)
            object_type = self.git("cat-file", "--batch-check=%(objecttype)",
                                   data=(oid + "\n").encode()).strip()
        require(object_type == b"commit", "base is not an available commit")

    def check_base_merge(self, request, base, head):
        require(isinstance(base, str) and OID.fullmatch(base),
                "remote base branch is missing; obtain a new endorsement")
        self.ensure_commit(request["base"])
        self.ensure_commit(base)
        require(self.git("merge-base", request["base"], base).decode().strip() == request["base"],
                "remote base changed without a fast-forward; obtain a new endorsement")
        result = subprocess.run(
            ["git", "merge-tree", "--write-tree", base, head],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=self.env, timeout=120,
        )
        if result.returncode not in (0, 1):
            raise RuntimeError(
                f"git merge-tree failed ({result.returncode}): "
                + result.stderr.decode("utf-8", errors="replace").strip()
            )
        require(result.returncode == 0,
                "remote base changed with merge conflicts; resolve them before endorsement")

    def snapshot(self, request, *, published=None, publication=None, merge_head=None):
        validate_request(request)
        expected = published if published and publication == "replace" else request["head"]
        for _ in range(3):
            require(self.ref("refs/heads/" + request["source_branch"]) == request["head"],
                    "local source branch changed; obtain a new endorsement")
            refs = self.remote_refs(request)
            require(refs.get("refs/heads/" + request["source_branch"]) == expected,
                    "remote source branch changed; obtain a new endorsement")
            base = refs.get("refs/heads/" + request["base_branch"])
            if base == request["base"]:
                return refs
            self.check_base_merge(request, base, merge_head or published or request["head"])
            current = self.remote_refs(request)
            require(current.get("refs/heads/" + request["source_branch"]) == expected
                    and self.ref("refs/heads/" + request["source_branch"]) == request["head"],
                    "source branch changed during mergeability checks; obtain a new endorsement")
            if current.get("refs/heads/" + request["base_branch"]) == base:
                return current
        raise ValueError("remote base kept advancing during mergeability checks; retry the same plan")

    def commits(self, request):
        return self.git("rev-list", "--reverse", "--topo-order",
                        request["head"], "^" + request["base"]).decode().splitlines()

    def commit(self, oid):
        require(isinstance(oid, str) and OID.fullmatch(oid), "invalid commit object id")
        raw = self.git("cat-file", "commit", oid)
        header, separator, message = raw.partition(b"\n\n")
        require(separator, "invalid commit encoding")
        blocks = []
        for line in header.split(b"\n"):
            if line.startswith(b" "):
                require(blocks, "invalid commit continuation")
                blocks[-1] += b"\n" + line
            else:
                blocks.append(line)
        require(not any(block.startswith(b"mergetag ") for block in blocks),
                "signed merge tags require manual handling; no commits were published")
        return blocks, message

    def payload(self, oid, mapping, committer=None):
        blocks, message = self.commit(oid)
        rewritten = []
        committer_count = 0
        for block in blocks:
            if block.startswith((b"gpgsig ", b"gpgsig-sha256 ")):
                continue
            if block.startswith(b"parent "):
                parent = block[7:].decode("ascii")
                block = b"parent " + mapping.get(parent, parent).encode("ascii")
            if committer is not None and block.startswith(b"committer "):
                parts = block.rsplit(b" ", 2)
                require(len(parts) == 3 and re.fullmatch(rb"[+-]?\d+", parts[1])
                        and re.fullmatch(rb"[+-]\d{4}", parts[2]),
                        "unsupported committer timestamp")
                identity = f"committer {committer['name']} <{committer['email']}>".encode()
                block = b" ".join((identity, parts[1], parts[2]))
                committer_count += 1
            rewritten.append(block)
        require(committer is None or committer_count == 1,
                "expected exactly one committer header")
        return b"\n".join(rewritten) + b"\n\n" + message

    def write_record(self, name, value):
        path = self.state / name
        if path.exists():
            require(json.loads(path.read_text()) == value, f"conflicting endorsement record: {name}")
            return
        with tempfile.NamedTemporaryFile(mode="w", dir=self.state) as output:
            output.write(canonical(value))
            output.flush()
            os.fsync(output.fileno())
            try:
                os.link(output.name, path)
            except FileExistsError:
                require(json.loads(path.read_text()) == value, f"concurrent endorsement record: {name}")

    def load_plan(self, plan_id):
        require(isinstance(plan_id, str) and PLAN_ID.fullmatch(plan_id), "invalid plan id")
        plan = json.loads((self.state / f"{plan_id}.plan.json").read_text())
        reviewed_plan_request(plan, plan_id)
        require(plan["root"] == self.root, "select the worktree where this plan was reviewed")
        require(plan["commits"] == self.commits(plan["request"]), "reviewed commit range changed")
        return plan

    def plan(self, request):
        self.snapshot(request)
        require(not self.git("status", "--porcelain", "--untracked-files=no").strip(),
                "commit or set aside tracked worktree changes before requesting endorsement")
        self.ensure_commit(request["base"])
        self.snapshot(request)
        commits = self.commits(request)
        require(commits, "the draft PR introduces no commits")
        for oid in commits:
            self.commit(oid)
        plan = {"request": request, "root": self.root, "commits": commits}
        plan_id = digest(plan)
        target = "refs/heads/" + request["target_branch"]
        exists = self.git("for-each-ref", "--format=%(refname)", target).decode().splitlines()
        require(target not in exists or (self.state / f"{plan_id}.receipt.json").exists(),
                "the signed branch already exists; do not overwrite it")
        self.write_record(f"{plan_id}.plan.json", plan)
        return {"plan_id": plan_id, **plan}

    def verify(self, plan_id):
        plan = self.load_plan(plan_id)
        receipt = json.loads((self.state / f"{plan_id}.receipt.json").read_text())
        require(receipt.get("plan_id") == plan_id and receipt.get("plan") == plan,
                "receipt does not match the reviewed plan")
        require(receipt.get("publication") in plan["request"]["publication_options"],
                "receipt has no approved publication method")
        mapping = receipt["mapping"]
        require(isinstance(mapping, dict) and set(mapping) == set(plan["commits"]),
                "signed commit mapping is incomplete")
        for index, original in enumerate(plan["commits"], 1):
            print(f"[copilot-cs-endorse] verifying {index}/{len(plan['commits'])}: {original}",
                  flush=True)
            signed = mapping[original]
            require(self.payload(signed, {}) ==
                    self.payload(original, mapping, plan["request"].get("committer")),
                    f"signed commit content or metadata differs: {original}")
            blocks, _ = self.commit(signed)
            signatures = [block[7:].replace(b"\n ", b"\n") + b"\n"
                          for block in blocks if block.startswith(b"gpgsig ")]
            require(len(signatures) == 1, "signed commit must have exactly one endorsement")
            verify_signature(plan["request"]["key"], self.payload(signed, {}), signatures[0])
        require(receipt["head"] == mapping[plan["request"]["head"]], "invalid signed head")
        return receipt

    @contextmanager
    def locked_plan(self, plan_id):
        require(isinstance(plan_id, str) and PLAN_ID.fullmatch(plan_id), "invalid plan id")
        lock = os.open(self.state / f"{plan_id}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise ValueError("this endorsement is already running; inspect its job") from error
            yield
        finally:
            os.close(lock)

    def sign(self, plan_id, approval):
        plan = self.load_plan(plan_id)
        request = plan["request"]
        publication = approved_publication(plan_id, request, approval)
        with self.locked_plan(plan_id):
            receipt_path = self.state / f"{plan_id}.receipt.json"
            if receipt_path.exists():
                receipt = self.verify(plan_id)
                require(receipt["publication"] == publication,
                        "publication choice differs from the existing endorsement; operator decision required")
                remote_head = self.remote_refs(request).get("refs/heads/" + request["source_branch"])
                self.snapshot(request, publication=publication,
                              published=receipt["head"] if remote_head == receipt["head"] else None,
                              merge_head=receipt["head"])
            else:
                self.snapshot(request)
                key = public_key(os.environ.get("COPILOT_CS_SIGNING_KEY", ""))
                require(key == request["key"], "forwarded signing key does not match the reviewed plan")
                socket = os.environ.get("COPILOT_CS_SIGNING_SOCKET", "")
                require(socket and Path(socket).is_socket(), "forwarded Secretive socket is unavailable")
                environment = dict(self.env, SSH_AUTH_SOCK=socket)
                mapping = {}
                with tempfile.TemporaryDirectory(prefix="copilot-endorse-") as directory:
                    key_file = Path(directory) / "endorsement.pub"
                    key_file.write_text(key + "\n")
                    for index, original in enumerate(plan["commits"], 1):
                        print(f"[copilot-cs-endorse] signing {index}/{len(plan['commits'])}: {original}",
                              flush=True)
                        payload = self.payload(original, mapping, request.get("committer"))
                        signature = run(
                            ["ssh-keygen", "-Y", "sign", "-n", "git", "-f", str(key_file)],
                            data=payload, env=environment,
                        )
                        verify_signature(key, payload, signature)
                        mapping[original] = self.git(
                            "hash-object", "-t", "commit", "-w", "--stdin",
                            data=signed_commit(payload, signature),
                        ).decode().strip()
                self.snapshot(request, merge_head=mapping[request["head"]])
                receipt = {"plan_id": plan_id, "plan": plan, "mapping": mapping,
                           "publication": publication,
                           "head": mapping[request["head"]]}
                self.write_record(f"{plan_id}.receipt.json", receipt)
                self.verify(plan_id)
            target = "refs/heads/" + request["target_branch"]
            current = self.git("for-each-ref", "--format=%(objectname)", target).decode().strip()
            require(not current or current == receipt["head"], "signed branch collision; nothing overwritten")
            if not current:
                self.git("update-ref", target, receipt["head"], "0" * len(receipt["head"]))
            return receipt

    def push(self, plan_id, approval):
        with self.locked_plan(plan_id):
            receipt = self.verify(plan_id)
            request = receipt["plan"]["request"]
            publication = approved_publication(plan_id, request, approval)
            destination = request["source_branch"] if publication == "replace" else request["target_branch"]
            target = "refs/heads/" + destination
            refs = self.remote_refs(request)
            other = request["target_branch"] if publication == "replace" else request["source_branch"]
            require(refs.get("refs/heads/" + other) != receipt["head"],
                    "the other publication method already published this endorsement; inspect it before proceeding")
            receipt = dict(receipt, publication=publication)
            if refs.get(target) != receipt["head"]:
                self.snapshot(request, merge_head=receipt["head"])
                expected = request["head"] if publication == "replace" else ""
                require(refs.get(target, "") == expected, "remote destination changed; nothing overwritten")
                # An empty expectation creates a new ref only; it cannot rewrite an existing branch.
                self.git("push", "--porcelain", "--no-follow-tags", "--recurse-submodules=check",
                         f"--force-with-lease={target}:{expected}",
                         "origin", f"{receipt['head']}:{target}")
            require(self.remote_refs(request).get(target) == receipt["head"],
                    "remote head was not confirmed after pushing")
            self.snapshot(request, published=receipt["head"], publication=publication)
            self.write_record(f"{plan_id}.{publication}.published.json", receipt)
            return receipt


def signed_commit(payload, signature):
    header, separator, message = payload.partition(b"\n\n")
    require(separator, "invalid signed commit payload")
    return (header + b"\ngpgsig " + signature.rstrip(b"\n").replace(b"\n", b"\n ")
            + b"\n\n" + message)


def verify_signature(key, payload, signature):
    with tempfile.TemporaryDirectory(prefix="copilot-verify-") as directory:
        allowed = Path(directory) / "allowed"
        signed = Path(directory) / "signature"
        allowed.write_text("endorser " + public_key(key) + "\n")
        signed.write_bytes(signature)
        run(["ssh-keygen", "-Y", "verify", "-f", str(allowed),
             "-I", "endorser", "-n", "git", "-s", str(signed)], data=payload)


def approved_publication(plan_id, request, approval):
    for publication in request["publication_options"]:
        if approval == f"{plan_id}:{publication}":
            return publication
    raise ValueError("explicit approval of this exact plan AND publication method is required")


def reviewed_plan_request(plan, plan_id):
    require(isinstance(plan, dict) and isinstance(plan_id, str)
            and PLAN_ID.fullmatch(plan_id) and digest(plan) == plan_id,
            "endorsement plan changed or its digest is invalid")
    request = plan.get("request")
    validate_request(request)
    commits = plan.get("commits")
    require(isinstance(plan.get("root"), str) and plan["root"].startswith("/")
            and isinstance(commits, list) and commits
            and all(isinstance(oid, str) and OID.fullmatch(oid) for oid in commits)
            and len(set(commits)) == len(commits) and commits[-1] == request["head"],
            "invalid reviewed commit range")
    return request


def signed_receipt_request(receipt, approval):
    require(isinstance(receipt, dict), "expected an endorsement receipt")
    request = reviewed_plan_request(receipt.get("plan"), receipt.get("plan_id"))
    publication = approved_publication(receipt["plan_id"], request, approval)
    require(receipt.get("publication") == publication,
            "publication choice differs from the signed receipt")
    mapping = receipt.get("mapping")
    require(isinstance(mapping, dict) and set(mapping) == set(receipt["plan"]["commits"])
            and all(isinstance(oid, str) and OID.fullmatch(oid) for oid in mapping.values())
            and receipt.get("head") == mapping.get(request["head"]),
            "incomplete signed commit receipt")
    return request, publication


def assignee_logins(pr):
    require(isinstance(pr, dict) and isinstance(pr.get("assignees"), list)
            and all(isinstance(user, dict) and isinstance(user.get("login"), str)
                    and user["login"] for user in pr["assignees"]),
            "invalid PR assignees")
    return {user["login"].casefold() for user in pr["assignees"]}


def set_attestation_assignment(request, awaiting, *, head=None, allow_closed=False,
                               require_draft=True, merge_pr=None):
    """Change only the planned attestor's assignment, with revision readback."""
    login = request.get("attestor")
    require(login, "plan has no attestor; prepare a new plan before tracking attestation")
    require(authenticated_operator().casefold() == login.casefold(),
            "authenticated operator differs from the planned attestor")
    expected = head if head is not None else request["head"]

    def confirm():
        return confirm_ci_revision(
            request, request["pr"], expected, request["source_branch"],
            require_draft=require_draft, allow_closed=allow_closed, merge_pr=merge_pr,
        )

    pr = confirm()
    before = assignee_logins(pr)
    assignee = login.casefold()
    if (assignee in before) != awaiting:
        response = github(
            f"repos/{request['repository']}/issues/{request['pr']}/assignees",
            "POST" if awaiting else "DELETE", {"assignees": [login]},
        )
        require((assignee in assignee_logins(response)) == awaiting,
                f"attestation assignment was not confirmed for {request['url']}")
    pr = confirm()
    after = assignee_logins(pr)
    require((assignee in after) == awaiting,
            f"attestation assignment was not confirmed for {request['url']}")
    require(before - {assignee} <= after, "other PR assignees changed during attestation update")
    return pr


def await_attestation(result):
    require(isinstance(result, dict) and all(key in result for key in
            ("request", "root", "commits", "plan_id")), "expected the complete planning result")
    plan = {key: result[key] for key in ("request", "root", "commits")}
    request = reviewed_plan_request(plan, result["plan_id"])
    require_passing_checks(request, request["pr"], request["head"], request["source_branch"],
                           require_draft=True)
    set_attestation_assignment(request, True)
    return {"url": request["url"], "head": request["head"],
            "attestor": request["attestor"], "awaiting_attestation": True}


def complete_attestation(receipt, approval):
    """Clear the wait using the successful Codespace sign/verify receipt."""
    request, _ = signed_receipt_request(receipt, approval)
    set_attestation_assignment(request, False)
    return {"url": request["url"], "head": request["head"],
            "attestor": request["attestor"], "awaiting_attestation": False}


def full_references(text, repository):
    text = re.sub(r"(?<![\w/])(?:([\w.-]+/[\w.-]+))?#(\d+)\b",
                  lambda match: f"https://github.com/{match[1] or repository}/issues/{match[2]}",
                  text.replace("\r\n", "\n"))
    return re.sub(r"\b(PR|pull request|issue)\s+(\d+)\b",
                  lambda match: f"{match[1]} https://github.com/{repository}/"
                  f"{'issues' if match[1].lower() == 'issue' else 'pull'}/{match[2]}",
                  text, flags=re.I)


def pull_metadata(pr):
    return {
        "labels": sorted(label["name"] for label in pr["labels"]),
        "assignees": sorted(user["login"] for user in pr["assignees"]),
        "milestone": pr["milestone"]["number"] if pr["milestone"] else None,
    }


def confirm_ci_revision(request, number, head, branch, *, require_draft=False, allow_closed=False,
                        merge_pr=None):
    """Confirm the expected revision, allowing closed originals only on resume."""
    repository = request["repository"]
    current = pull_request(repository, number, require_draft=require_draft)
    require(current["state"] in (("open", "closed") if allow_closed else ("open",))
            and current["head"]["sha"] == head
            and current["head"]["ref"] == branch
            and current["base"]["ref"] == request["base_branch"],
            "PR changed or is no longer open; quality gate not confirmed")
    confirm_base_compatibility(request, merge_pr or current)
    require(branch_head(repository, branch) == head,
            "PR head branch changed; quality gate not confirmed")
    return current


def require_passing_workflows(request, number, head, branch, workflows):
    """Verify required workflow provenance, latest attempts, and the exact PR."""
    repository = request["repository"]
    expected = set()
    sources = {}
    for workflow in workflows:
        require(isinstance(workflow, dict)
                and type(workflow.get("repository_id")) is int and workflow["repository_id"] > 0
                and isinstance(workflow.get("path"), str)
                and re.fullmatch(r"\.github/workflows/[^/\x00-\x1f]+\.(?:yml|yaml)", workflow["path"]),
                "invalid required workflow rules")
        sha, ref = workflow.get("sha"), workflow.get("ref")
        require((sha is None or isinstance(sha, str) and OID.fullmatch(sha))
                and (isinstance(ref, str) and ref or sha is not None),
                "invalid required workflow revision")
        source_id = workflow["repository_id"]
        if source_id not in sources:
            source = github(f"repositories/{source_id}")
            require(isinstance(source, dict) and source.get("id") == source_id
                    and isinstance(source.get("full_name"), str)
                    and re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", source["full_name"]),
                    "invalid required workflow source repository")
            sources[source_id] = source["full_name"]
        expected.add((sources[source_id], workflow["path"], sha or ""))

    runs = github_pages(
        f"repos/{repository}/actions/runs?head_sha={head}&per_page=100", field="workflow_runs")
    latest = {}
    paths = {path for _, path, _ in expected}
    identities = {(repo, path) for repo, path, _ in expected}
    observations = {path: [] for path in paths}
    query = """
        query EndorsementWorkflowRun($id: ID!) {
          node(id: $id) {
            ... on CheckSuite {
              workflowRun {
                databaseId runAttempt event
                file { path repositoryName repositoryFileUrl }
                workflow { databaseId resourcePath }
              }
            }
          }
        }
    """
    for candidate in runs:
        require(isinstance(candidate, dict) and isinstance(candidate.get("path"), str),
                "invalid required workflow run")
        if candidate["path"] not in paths:
            continue
        observation = {
            "run_id": candidate.get("id") if type(candidate.get("id")) is int else None,
            "rejected_by": [],
        }
        observations[candidate["path"]].append(observation)
        workflow_id = candidate.get("workflow_id")
        required_url = (f"https://api.github.com/repos/{repository}/actions/"
                        f"required_workflows/{workflow_id}")
        if candidate.get("workflow_url") != required_url:
            observation["rejected_by"] = ["workflow-url"]
            continue
        require(isinstance(candidate.get("repository"), dict)
                and isinstance(candidate.get("pull_requests"), list),
                "invalid required workflow PR association")
        observation["rejected_by"] = [
            name for name, matches in (
                ("head-sha", candidate.get("head_sha") == head),
                ("head-branch", candidate.get("head_branch") == branch),
                ("event", candidate.get("event") in ("pull_request", "pull_request_target")),
                ("repository", candidate["repository"].get("full_name") == repository),
                ("pull-request-association", any(
                    isinstance(pr, dict) and pr.get("number") == number
                    and isinstance(pr.get("head"), dict) and pr["head"].get("sha") == head
                    and isinstance(pr.get("base"), dict)
                    and pr["base"].get("ref") == request["base_branch"]
                    for pr in candidate["pull_requests"])),
            ) if not matches
        ]
        if observation["rejected_by"]:
            continue
        require(type(candidate.get("id")) is int and candidate["id"] > 0
                and type(workflow_id) is int and workflow_id > 0
                and type(candidate.get("run_attempt")) is int and candidate["run_attempt"] > 0
                and isinstance(candidate.get("check_suite_node_id"), str)
                and candidate["check_suite_node_id"], "invalid required workflow run identity")
        response = github("graphql", "POST", {
            "query": query, "variables": {"id": candidate["check_suite_node_id"]},
        })
        require(isinstance(response, dict) and not response.get("errors")
                and isinstance(response.get("data"), dict)
                and isinstance(response["data"].get("node"), dict),
                "GitHub could not verify required workflow provenance")
        provenance = response["data"]["node"].get("workflowRun")
        require(isinstance(provenance, dict)
                and provenance.get("databaseId") == candidate["id"]
                and provenance.get("runAttempt") == candidate["run_attempt"]
                and provenance.get("event") == candidate["event"]
                and isinstance(provenance.get("workflow"), dict)
                and provenance["workflow"].get("databaseId") == workflow_id
                and isinstance(provenance.get("file"), dict),
                "required workflow run changed or its provenance is unavailable")
        source = provenance["file"]
        require(isinstance(source.get("repositoryName"), str)
                and isinstance(source.get("path"), str),
                "invalid required workflow source identity")
        key = (source.get("repositoryName"), source.get("path"))
        observation["source"] = {"repository": key[0], "path": key[1]}
        if key not in identities:
            observation["rejected_by"] = ["source-identity"]
            continue
        require(source["path"] == candidate["path"]
                and provenance["workflow"].get("resourcePath")
                == f"/{repository}/actions/workflows/required/{key[0]}/{key[1]}",
                "required workflow source does not match its enforced workflow")
        if key not in latest or candidate["id"] > latest[key][0]["id"]:
            latest[key] = (candidate, source)

    for source_repository, path, sha in sorted(expected):
        key = (source_repository, path)
        label = f"{source_repository}/{path}"
        require(key in latest, f"missing required workflow {label}; quality gate blocked; "
                "workflow selection: " + canonical({
                    "repository": repository, "pr": number, "head": head, "branch": branch,
                    "base_branch": request["base_branch"], "required_source": label,
                    "runs_returned": len(runs), "candidates": observations[path],
                }))
        candidate, source = latest[key]
        file_url = source.get("repositoryFileUrl")
        prefix = f"https://github.com/{source_repository}/blob/"
        suffix = f"/{quote(path, safe='/')}"
        require(isinstance(file_url, str),
                f"invalid required workflow source revision for {label}; quality gate blocked")
        recorded_sha = file_url[len(prefix):-len(suffix)]
        require(OID.fullmatch(recorded_sha) and file_url == f"{prefix}{recorded_sha}{suffix}",
                f"invalid required workflow source revision for {label}; quality gate blocked")
        require(not sha or recorded_sha == sha,
                f"required workflow pinned source revision changed for {label}; quality gate blocked")
        current = github(f"repos/{repository}/actions/runs/{candidate['id']}")
        require(isinstance(current, dict) and all(
            current.get(field) == candidate.get(field) for field in (
                "id", "workflow_id", "workflow_url", "check_suite_node_id", "run_attempt",
                "head_sha", "head_branch", "event", "path", "repository", "pull_requests")),
            f"required workflow changed for {label}; quality gate blocked")
        require(current.get("status") == "completed" and current.get("conclusion") == "success",
                f"required workflow is not succeeding for {label}: "
                f"{current.get('conclusion') or current.get('status')}; quality gate blocked")


def require_passing_checks(request, number, head, branch, *, require_draft=False):
    """Read the exact revision's required CI without changing its PR."""
    repository = request["repository"]
    pr = confirm_ci_revision(request, number, head, branch, require_draft=require_draft)
    url = pr["html_url"]
    expected = set()
    workflows = []
    rules = github_pages(
        f"repos/{repository}/rules/branches/{quote(request['base_branch'], safe='')}?per_page=100")
    for rule in rules:
        require(isinstance(rule, dict) and isinstance(rule.get("type"), str),
                "invalid required-check policy")
        if rule["type"] == "workflows":
            parameters = rule.get("parameters")
            require(isinstance(parameters, dict)
                    and isinstance(parameters.get("workflows"), list) and parameters["workflows"],
                    "invalid required workflow rules")
            workflows.extend(parameters["workflows"])
        if rule["type"] == "required_status_checks":
            parameters = rule.get("parameters")
            require(isinstance(parameters, dict)
                    and isinstance(parameters.get("required_status_checks"), list),
                    "invalid required status-check policy")
            checks = parameters["required_status_checks"]
            for check in checks:
                require(isinstance(check, dict) and isinstance(check.get("context"), str)
                        and check["context"], "invalid required status-check context")
                expected.add(check["context"])

    query = """
        query EndorsementRequiredChecks($id: ID!, $cursor: String) {
          node(id: $id) {
            ... on PullRequest {
              id state headRefOid headRefName baseRefName mergeable
              baseRef {
                target { oid }
                branchProtectionRule { requiresStatusChecks requiredStatusCheckContexts }
              }
              commits(last: 1) {
                nodes {
                  commit {
                    oid
                    statusCheckRollup {
                      contexts(first: 100, after: $cursor) {
                        nodes {
                          __typename
                          ... on CheckRun {
                            name status conclusion isRequired(pullRequestId: $id)
                          }
                          ... on StatusContext {
                            context state isRequired(pullRequestId: $id)
                          }
                        }
                        pageInfo { hasNextPage endCursor }
                      }
                    }
                  }
                }
              }
            }
          }
        }
    """
    reported = set()
    failures = []
    cursor = None
    cursors = set()
    while True:
        response = github("graphql", "POST", {
            "query": query, "variables": {"id": pr["node_id"], "cursor": cursor},
        })
        require(isinstance(response, dict) and not response.get("errors"),
                "GitHub could not resolve required CI checks")
        require(isinstance(response.get("data"), dict),
                "GitHub did not return required CI data")
        current = response["data"]["node"]
        require(isinstance(current, dict) and current.get("id") == pr["node_id"]
                and current["state"] == "OPEN"
                and current["headRefOid"] == head and current["headRefName"] == branch
                and current["baseRefName"] == request["base_branch"]
                and isinstance(current.get("baseRef"), dict)
                and isinstance(current["baseRef"].get("target"), dict),
                "PR or base changed while checking required CI")
        require_base_compatibility(
            request, current["baseRef"]["target"].get("oid"), current.get("mergeable"))
        protection = current["baseRef"]["branchProtectionRule"]
        if protection is not None:
            require(isinstance(protection, dict)
                    and type(protection.get("requiresStatusChecks")) is bool,
                    "invalid classic required-check policy")
            if protection["requiresStatusChecks"]:
                contexts = protection["requiredStatusCheckContexts"]
                require(isinstance(contexts, list)
                        and all(isinstance(name, str) and name for name in contexts),
                        "invalid classic required status-check contexts")
                expected.update(contexts)
        commits = current["commits"]["nodes"]
        require(isinstance(commits, list) and len(commits) == 1
                and commits[0]["commit"]["oid"] == head,
                "CI results do not belong to the expected PR head")
        rollup = commits[0]["commit"]["statusCheckRollup"]
        require(isinstance(rollup, dict), f"no required CI checks reported for {url}; quality gate blocked")
        contexts = rollup["contexts"]
        require(isinstance(contexts, dict) and isinstance(contexts.get("nodes"), list),
                "invalid required CI response")
        for check in contexts["nodes"]:
            require(isinstance(check, dict) and type(check.get("isRequired")) is bool,
                    "invalid required CI result")
            if not check["isRequired"]:
                continue
            if check["__typename"] == "CheckRun":
                name = check["name"]
                passed = (check["status"] == "COMPLETED"
                          and check["conclusion"] in ("SUCCESS", "NEUTRAL", "SKIPPED"))
                state = (check["conclusion"] or check["status"]
                         if check["status"] == "COMPLETED" else check["status"])
            else:
                require(check["__typename"] == "StatusContext", "unknown required CI result type")
                name, state = check["context"], check["state"]
                passed = state == "SUCCESS"
            require(isinstance(name, str) and name, "missing required CI check name")
            reported.add(name)
            if not passed:
                failures.append(f"{name}: {state}")
        page = contexts["pageInfo"]
        require(isinstance(page, dict) and type(page.get("hasNextPage")) is bool,
                "invalid CI pagination")
        if not page["hasNextPage"]:
            break
        cursor = page["endCursor"]
        require(isinstance(cursor, str) and cursor and cursor not in cursors,
                "invalid CI pagination cursor")
        cursors.add(cursor)

    require(not expected - reported,
            f"missing required CI checks for {url}: {', '.join(sorted(expected - reported))}; quality gate blocked")
    require(not failures,
            f"required CI is not succeeding for {url}: {'; '.join(failures)}; quality gate blocked")
    if workflows:
        require_passing_workflows(request, number, head, branch, workflows)
    require(reported or workflows,
            f"no required CI checks reported for {url}; quality gate blocked")
    return confirm_ci_revision(request, number, head, branch, require_draft=require_draft)


def ready_for_review(request, number, head, branch):
    """Promote only the verified signed revision with passing required CI."""
    pr = require_passing_checks(request, number, head, branch)
    attestor = request.get("attestor")
    require(attestor is None or attestor.casefold() not in assignee_logins(pr),
            "attestor is still assigned; clear the attestation wait before readiness")
    if pr["draft"]:
        response = github("graphql", "POST", {
            "query": """
                mutation EndorsementReady($id: ID!) {
                  markPullRequestReadyForReview(input: {pullRequestId: $id}) {
                    pullRequest { id isDraft }
                  }
                }
            """,
            "variables": {"id": pr["node_id"]},
        })
        require(isinstance(response, dict) and not response.get("errors"),
                "GitHub did not confirm the ready-for-review mutation")
        require(isinstance(response.get("data"), dict)
                and isinstance(response["data"].get("markPullRequestReadyForReview"), dict),
                "ready-for-review transition not confirmed")
        updated = response["data"]["markPullRequestReadyForReview"]["pullRequest"]
        require(isinstance(updated, dict)
                and updated["id"] == pr["node_id"] and updated["isDraft"] is False,
                "ready-for-review transition not confirmed")
    current = confirm_ci_revision(request, number, head, branch)
    require(current["draft"] is False, "ready-for-review transition not confirmed")
    require(attestor is None or attestor.casefold() not in assignee_logins(current),
            "attestor was assigned during the ready-for-review transition")
    return {"url": pr["html_url"], "head": head, "ready_for_review": True}


def finish(receipt, approval):
    request, publication = signed_receipt_request(receipt, approval)
    plan = receipt["plan"]
    plan_id = receipt["plan_id"]
    repository = request["repository"]
    pr = pull_request(repository, request["pr"], require_draft=publication != "replace")
    expected = receipt["head"] if publication == "replace" else request["head"]
    require(pr["head"]["sha"] == expected
            and pr["head"]["ref"] == request["source_branch"]
            and pr["base"]["ref"] == request["base_branch"], "PR changed after endorsement")
    marker = f"<!-- copilot-endorsement:{plan_id} -->"
    target = request["source_branch"] if publication == "replace" else request["target_branch"]
    replacement = None
    if publication == "replacement":
        candidates = github_pages(f"repos/{repository}/pulls?state=all&head="
                                  + quote(repository.split("/")[0] + ":" + target, safe="")
                                  + "&per_page=100")
        require(len(candidates) <= 1, "multiple replacement PRs exist; operator decision required")
        if candidates:
            require(marker in (candidates[0]["body"] or ""),
                    "existing PR is not this endorsement's replacement")
            replacement = pull_request(repository, candidates[0]["number"], require_draft=False)
            require(replacement["state"] == "open"
                    and replacement["head"]["sha"] == receipt["head"]
                    and replacement["head"]["ref"] == target
                    and replacement["base"]["ref"] == request["base_branch"]
                    and marker in (replacement["body"] or ""), "replacement draft PR does not match")
    merge_pr = replacement or pr
    confirm_base_compatibility(request, merge_pr)
    branch = github(f"repos/{repository}/branches/{quote(target, safe='')}")
    require(branch["commit"]["sha"] == receipt["head"], "published signed branch changed")
    for original in plan["commits"]:
        before = github(f"repos/{repository}/git/commits/{original}")
        after = github(f"repos/{repository}/git/commits/{receipt['mapping'][original]}")
        require(isinstance(before["committer"], dict), "invalid reviewed committer metadata")
        expected_committer = {**before["committer"], **request.get("committer", {})}
        require(before["tree"]["sha"] == after["tree"]["sha"]
                and all(before[field] == after[field] for field in ("message", "author"))
                and after["committer"] == expected_committer
                and [receipt["mapping"].get(parent["sha"], parent["sha"]) for parent in before["parents"]]
                == [parent["sha"] for parent in after["parents"]],
                f"published commit differs from reviewed commit: {original}")
        verification = after["verification"]
        require(verification["verified"] and verification.get("signature") and verification.get("payload"),
                "GitHub has not verified the endorsement; check signing-key registration")
        verify_signature(request["key"], verification["payload"].encode(),
                         verification["signature"].encode())
        raw = signed_commit(verification["payload"].encode(), verification["signature"].encode())
        hasher = hashlib.sha1 if len(receipt["mapping"][original]) == 40 else hashlib.sha256
        require(hasher(b"commit " + str(len(raw)).encode() + b"\0" + raw).hexdigest()
                == receipt["mapping"][original], "GitHub signature payload does not match the signed object")
    confirm_base_compatibility(request, merge_pr)
    if "attestor" in request:
        updated = set_attestation_assignment(
            request, False, head=expected, allow_closed=publication == "replacement",
            require_draft=publication != "replace", merge_pr=merge_pr,
        )
        pr["assignees"] = updated["assignees"]
    if publication == "replace":
        require(pr["state"] == "open", "the original draft PR is no longer open")
        return ready_for_review(request, request["pr"], receipt["head"], target)

    title = full_references(pr["title"], repository)
    body = (full_references(pr["body"] or "", repository)
            + f"\n\nSigned replacement for {request['url']}.\n\n{marker}")
    if replacement is None:
        require(pr["state"] == "open", "original PR closed before replacement creation")
        replacement = github(f"repos/{repository}/pulls", "POST", {
            "title": title, "body": body,
            "base": request["base_branch"], "head": target, "draft": True,
        })
    replacement = pull_request(repository, replacement["number"], require_draft=False)
    require(replacement["state"] == "open" and replacement["head"]["sha"] == receipt["head"]
            and replacement["base"]["ref"] == request["base_branch"], "replacement draft PR does not match")
    confirm_base_compatibility(request, replacement)
    github(f"repos/{repository}/issues/{replacement['number']}", "PATCH", pull_metadata(pr))
    current_reviewers = {user["login"] for user in replacement["requested_reviewers"]}
    current_teams = {team["slug"] for team in replacement["requested_teams"]}
    reviewers = [user["login"] for user in pr["requested_reviewers"]
                 if user["login"] not in current_reviewers]
    teams = [team["slug"] for team in pr["requested_teams"] if team["slug"] not in current_teams]
    if reviewers or teams:
        requested = github(f"repos/{repository}/pulls/{replacement['number']}/requested_reviewers", "POST",
                           {"reviewers": reviewers, "team_reviewers": teams})
        require(set(reviewers) <= {user["login"] for user in requested["requested_reviewers"]}
                and set(teams) <= {team["slug"] for team in requested["requested_teams"]},
                "requested reviewers were not preserved; leaving the original PR open")

    def confirm_drafts():
        latest = pull_request(repository, request["pr"])
        require(latest["head"]["sha"] == request["head"]
                and latest["head"]["ref"] == request["source_branch"]
                and latest["base"]["ref"] == request["base_branch"]
                and latest["title"] == pr["title"] and latest["body"] == pr["body"]
                and pull_metadata(latest) == pull_metadata(pr),
                "original PR changed; leaving both drafts open")
        current = pull_request(repository, replacement["number"], require_draft=False)
        require(current["state"] == "open" and current["head"]["sha"] == receipt["head"]
                and current["head"]["ref"] == request["target_branch"]
                and current["base"]["ref"] == request["base_branch"]
                and marker in (current["body"] or ""), "replacement changed; leaving the original PR open")
        require(current["title"] == title and current["body"] == body
                and pull_metadata(current) == pull_metadata(pr),
                "replacement metadata differs; leaving the original PR open")
        confirm_base_compatibility(request, current)
        return latest

    confirm_drafts()
    comment = (f"Superseded by {replacement['html_url']}, containing the reviewed commit range "
               f"signed with the endorsement key `{request['fingerprint']}`. {marker}")
    comments = github_pages(f"repos/{repository}/issues/{request['pr']}/comments?per_page=100")
    if not any(item["body"] == comment for item in comments):
        github(f"repos/{repository}/issues/{request['pr']}/comments", "POST", {"body": comment})
    latest = confirm_drafts()
    if latest["state"] == "open":
        github(f"repos/{repository}/pulls/{request['pr']}", "PATCH", {"state": "closed"})
    result = ready_for_review(request, replacement["number"], receipt["head"], target)
    return dict(result, replaces=request["url"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    ci_parser = actions.add_parser(
        "check-ci", help="LOCAL: check unsigned-draft CI without starting endorsement")
    ci_parser.add_argument("--repo", required=True)
    ci_parser.add_argument("--pr", required=True, type=int)
    prepare_parser = actions.add_parser(
        "prepare", help="LOCAL: require passing CI, then snapshot draft PR and publication policy")
    prepare_parser.add_argument("--repo", required=True)
    prepare_parser.add_argument("--pr", required=True, type=int)
    prepare_parser.add_argument("--key", default=os.environ.get("COPILOT_SECRETIVE_SIGNING_PUBLIC_KEY", SIGNING_ALIAS))
    prepare_parser.add_argument("--committer-name")
    prepare_parser.add_argument("--committer-email")
    plan_parser = actions.add_parser("plan", help="CODESPACE: freeze the commit range for human review")
    plan_parser.add_argument("--request", required=True)
    awaiting_parser = actions.add_parser(
        "await-attestation", help="LOCAL: assign the operator before the exact-plan review prompt")
    awaiting_parser.add_argument("--plan", required=True, dest="plan_file",
                                 help="JSON file containing the complete planning result")
    completed_parser = actions.add_parser(
        "complete-attestation", help="LOCAL: unassign after successful Codespace signing/verification")
    completed_parser.add_argument("--receipt", required=True)
    completed_parser.add_argument("--approve-plan", required=True)
    for action in ("sign", "verify", "push"):
        subparser = actions.add_parser(action, help="CODESPACE: " + action + " the exact reviewed plan")
        subparser.add_argument("--plan", required=True)
        if action != "verify":
            subparser.add_argument("--approve-plan", required=True)
    finish_parser = actions.add_parser(
        "finish", help="LOCAL: verify publication and mark the signed PR ready after required CI passes")
    finish_parser.add_argument("--receipt", required=True)
    finish_parser.add_argument("--approve-plan", required=True)
    args = parser.parse_args()
    remote = args.action in ("plan", "sign", "verify", "push")
    try:
        if remote:
            require(os.environ.get("CODESPACES") == "true", "run this action inside the selected Codespace")
            repository = Repository()
            if args.action == "plan":
                result = repository.plan(json.loads(args.request))
            elif args.action == "verify":
                result = repository.verify(args.plan)
            else:
                result = getattr(repository, args.action)(args.plan, args.approve_plan)
        elif args.action == "check-ci":
            require(os.environ.get("CODESPACES") != "true",
                    "check GitHub CI locally with the operator's authenticated gh")
            result = dict(check_ci(args.repo, args.pr), required_ci="passed")
        elif args.action == "prepare":
            require(os.environ.get("CODESPACES") != "true",
                    "run GitHub preparation locally with the operator's authenticated gh")
            require((args.committer_name is None) == (args.committer_email is None),
                    "provide both committer name and email")
            committer = ({"name": args.committer_name, "email": args.committer_email}
                         if args.committer_name is not None else None)
            result = prepare(args.repo, args.pr, args.key, committer=committer)
        elif args.action in ("await-attestation", "complete-attestation"):
            require(os.environ.get("CODESPACES") != "true",
                    "run GitHub attestation tracking locally with the operator's authenticated gh")
            if args.action == "await-attestation":
                result = await_attestation(json.loads(Path(args.plan_file).read_text()))
            else:
                result = complete_attestation(
                    json.loads(Path(args.receipt).read_text()), args.approve_plan)
        else:
            require(os.environ.get("CODESPACES") != "true",
                    "run GitHub finalisation locally with the operator's authenticated gh")
            result = finish(json.loads(Path(args.receipt).read_text()), args.approve_plan)
        print((RESULT_PREFIX if remote else "") + canonical(result))
        return 0
    except (ValueError, RuntimeError, OSError, KeyError, subprocess.TimeoutExpired) as error:
        print(f"[copilot-cs-endorse] {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
