#!/usr/bin/env bash
#
# Run gh Codespaces SSH operations with a Secretive-backed identity only.
#
# gh requires an identity path whose sibling <path>.pub can be uploaded to the
# Codespace. Secretive exposes public-key stand-in files but no private key, so
# this wrapper creates two symlinks to the active stand-in. OpenSSH reads the
# public key from the base path and delegates signing to Secretive.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SECRETIVE_DATA_DIR="${COPILOT_SECRETIVE_DATA_DIR:-$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data}"
SECRETIVE_SOCKET="${COPILOT_SECRETIVE_AGENT_SOCKET:-${COPILOT_SECRETIVE_SOCKET:-$SECRETIVE_DATA_DIR/socket.ssh}}"
SECRETIVE_STANDIN="${COPILOT_SECRETIVE_STANDIN:-$HOME/.ssh/secretive-codespaces-agent-sep-2026}"
SECRETIVE_PUBLIC_KEY="${COPILOT_SECRETIVE_PUBLIC_KEY:-$SECRETIVE_STANDIN.pub}"
SECRETIVE_SIGNING_KEY="${COPILOT_SECRETIVE_SIGNING_PUBLIC_KEY:-$HOME/.ssh/secretive-stormbreaker-github-sep-2026.pub}"

log() { printf '[copilot-ghcs] %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

standin_dir=$(dirname "$SECRETIVE_STANDIN")
mode="${1:-}"
if [[ "$mode" == "resume-auth" ]]; then
	[[ $# -eq 2 && "$2" == "--operator-approved" ]] ||
		die "usage: copilot-ghcs resume-auth --operator-approved"
	exec python3 "$SCRIPT_DIR/copilot-gh-retry" resume-auth \
		--lock "$standin_dir/copilot-ghcs-connect.lock" --operator-approved
fi
codespace="${2:-}"
[[ "$mode" == "ssh" || "$mode" == "ssh-sign" || "$mode" == "cp" ]] ||
	die "usage: copilot-ghcs {ssh|ssh-sign|cp} CODESPACE [arguments...]; or resume-auth --operator-approved"
[[ "$codespace" =~ ^[A-Za-z0-9._-]+$ ]] ||
	die "invalid Codespace id: $codespace"
shift 2

job_id=
if [[ "$mode" != "cp" && "${1:-}" == "--job-id" ]]; then
	job_id="${2:-}"
	[[ "$job_id" =~ ^[A-Za-z0-9._-]+$ ]] ||
		die "invalid runner job id: $job_id"
	shift 2
	[[ $# -eq 1 && "$1" != -* ]] ||
		die "--job-id requires exactly one remote runner command"
fi

if [[ "$mode" == "cp" ]]; then
	(( $# >= 2 )) || die "usage: copilot-ghcs cp CODESPACE SOURCE... DESTINATION"
	remote_paths=0
	for path in "$@"; do
		if [[ "$path" == remote:* ]]; then
			remote_paths=$((remote_paths + 1))
			[[ "$path" =~ ^remote:[A-Za-z0-9_./+@,=:-]+$ ]] ||
				die "unsafe remote copy path: $path"
		fi
	done
	(( remote_paths > 0 )) ||
		die "a copy source or destination must use the remote: prefix"
fi

[[ -S "$SECRETIVE_SOCKET" ]] ||
	die "Secretive agent socket is unavailable: $SECRETIVE_SOCKET"

mkdir -p "$standin_dir"
chmod 700 "$standin_dir"

# scp disables LocalCommand; the local SSH authentication diagnostic frees the gate.
ssh_args=(
	-F /dev/null
	-i "$SECRETIVE_STANDIN"
	-o "IdentitiesOnly=yes"
	-o "IdentityAgent=$SECRETIVE_SOCKET"
	-o "PreferredAuthentications=publickey"
	-o "BatchMode=yes"
	-o "LogLevel=VERBOSE"
	-o "ServerAliveInterval=15"
	-o "ServerAliveCountMax=3"
)
if [[ "$mode" == "ssh-sign" ]]; then
	export SSH_AUTH_SOCK="$SECRETIVE_SOCKET"
	ssh_args+=(-A)
else
	ssh_args+=(-o "ForwardAgent=no")
fi

retry=(python3 "$SCRIPT_DIR/copilot-gh-retry" connect
	--lock "$standin_dir/copilot-ghcs-connect.lock"
	--public-key "$SECRETIVE_PUBLIC_KEY" --standin "$SECRETIVE_STANDIN"
	--signing-public-key "$SECRETIVE_SIGNING_KEY")
if [[ -n "$job_id" ]]; then
	retry+=(--ack-marker "__COPILOT_CS_ACK_${job_id}__")
fi
if [[ "$mode" == "ssh-sign" ]]; then
	[[ $# -eq 1 && "$1" != -* ]] ||
		die "ssh-sign requires exactly one remote command"
	retry+=(--ssh-signing)
fi

case "$mode" in
ssh|ssh-sign)
	# Interactive or option-led invocations retain their one-attempt semantics.
	if [[ $# -eq 0 || "$1" == -* ]]; then
		retry+=(--no-retry)
	fi
	exec "${retry[@]}" -- gh codespace ssh -c "$codespace" -- "${ssh_args[@]}" "$@"
	;;
cp)
	# Expansion avoids scp treating gh's protective quotes as literal path
	# characters. Remote paths are restricted above before enabling it.
	exec "${retry[@]}" -- gh codespace cp -c "$codespace" --expand --recursive \
		-- "${ssh_args[@]}" "$@"
	;;
esac
