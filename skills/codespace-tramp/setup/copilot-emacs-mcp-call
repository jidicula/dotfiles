#!/usr/bin/env python3
"""Invoke eval-elisp through the dedicated Codespace MCP bridge."""

import json
import math
import os
import select
import subprocess
import sys
import time
from pathlib import Path


BRIDGE = Path(__file__).with_name("copilot-emacs-mcp")


def fail(message):
    print(f"[copilot-emacs-mcp-call] {message}", file=sys.stderr)
    return 1


def send(process, message):
    process.stdin.write((json.dumps(message, separators=(",", ":")) + "\n").encode())
    process.stdin.flush()


class ResponseReader:
    def __init__(self, process):
        self.process = process
        self.buffer = bytearray()

    def read(self, request_id, timeout):
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError(
                    f"timed out after {timeout:g}s waiting for response {request_id}"
                )
            if b"\n" in self.buffer:
                line, _, self.buffer = self.buffer.partition(b"\n")
                try:
                    message = json.loads(line)
                except (ValueError, UnicodeDecodeError) as error:
                    raise RuntimeError(f"bridge returned invalid JSON: {error}") from error
                if not isinstance(message, dict):
                    raise RuntimeError("bridge returned a non-object JSON-RPC message")
                if message.get("id") == request_id:
                    return message
                continue
            ready, _, _ = select.select([self.process.stdout], [], [], remaining)
            if ready:
                # A text readline can block on a partial frame, or prefetch a
                # second frame that select then cannot see. Own the buffer.
                data = os.read(self.process.stdout.fileno(), 65536)
                if not data:
                    raise RuntimeError(
                        f"bridge exited before response {request_id} "
                        f"(status {self.process.poll()})"
                    )
                self.buffer.extend(data)


def print_tool_result(message):
    if "error" in message:
        return fail(f"MCP error: {json.dumps(message['error'], separators=(',', ':'))}")

    result = message.get("result", {})
    texts = [
        item["text"]
        for item in result.get("content", [])
        if item.get("type") == "text" and "text" in item
    ]
    if texts:
        print("\n".join(texts))
    else:
        print(json.dumps(result, separators=(",", ":")))
    return 1 if result.get("isError") else 0


def main():
    if len(sys.argv) > 2:
        return fail("usage: copilot-emacs-mcp-call [ELISP]")

    expression = sys.argv[1] if len(sys.argv) == 2 else sys.stdin.read()
    if not expression.strip():
        return fail("an Elisp expression is required")

    try:
        timeout = float(os.environ.get("COPILOT_MCP_CALL_TIMEOUT", "30"))
    except ValueError:
        return fail("COPILOT_MCP_CALL_TIMEOUT must be a number")
    if not math.isfinite(timeout) or timeout <= 0:
        return fail("COPILOT_MCP_CALL_TIMEOUT must be finite and greater than zero")

    try:
        process = subprocess.Popen(
            [str(BRIDGE)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            bufsize=0,
        )
    except OSError as error:
        return fail(f"could not start bridge: {error}")
    try:
        reader = ResponseReader(process)
        send(
            process,
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {},
                    "clientInfo": {
                        "name": "copilot-emacs-mcp-call",
                        "version": "1",
                    },
                },
            },
        )
        initialization = reader.read(1, timeout)
        if "error" in initialization:
            return fail(
                "initialization failed: "
                + json.dumps(initialization["error"], separators=(",", ":"))
            )

        send(
            process,
            {
                "jsonrpc": "2.0",
                "method": "notifications/initialized",
                "params": {},
            },
        )
        send(
            process,
            {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "tools/call",
                "params": {
                    "name": "eval-elisp",
                    "arguments": {"expression": expression},
                },
            },
        )
        return print_tool_result(reader.read(2, timeout))
    except (BrokenPipeError, OSError, RuntimeError, TimeoutError) as error:
        return fail(str(error))
    finally:
        if process.stdin:
            try:
                process.stdin.close()
            except BrokenPipeError:
                pass
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        process.stdout.close()


if __name__ == "__main__":
    sys.exit(main())
