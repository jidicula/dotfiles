[commit]
	template = ~/.git-commit-message
    gpgSign = true
[tag]
    gpgSign = true
[init]
	templatedir = ~/.git-templates
	defaultBranch = "main"
[branch]
	autosetuprebase = always
[core]
	excludesfile = ~/.gitignore
	autocrlf = input
	untrackedcache = true
[github]
	user = jidicula
[merge]
	conflictstyle=diff3
[pull]
	rebase = true
[diff]
    # Use the slower but better patience diff algorithm
	algorithm = patience
	# Use new diff algorithm to make e.g. function diffs look better.
	compactionheuristic = true
[help]
    autocorrect = prompt
[push]
    autoSetupRemote = true
# default user email and key
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[url "git@github.com:github/"]
	insteadOf = https://github.com/github/
[include]
    path = ~/.gitconfig-personal
# Work repos + their worktrees. Anchored to ~/ so it won't match the
# "worktrees" component in personal-repo worktree gitdirs.
[includeIf "gitdir:~/work*/**"]
    path = ~/.gitconfig-work
# gitconfig-codespaces [include]s gitconfig-work, then overrides for Codespaces.
[includeIf "gitdir:**/workspaces/**"]
    path = ~/.gitconfig-codespaces
